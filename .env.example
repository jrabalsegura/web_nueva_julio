# Origen exacto usado en el navegador. En producción: https://tu-dominio.es
APP_ORIGIN=http://localhost:3080
# Otros orígenes exactos permitidos, separados por comas; sin rutas ni comodines.
APP_ADDITIONAL_ORIGINS=
APP_PORT=3080
ADMIN_USERNAME=admin
# Usuario y hash solo inicializan la cuenta si todavía no existe en SQLite.
# Los cambios desde /admin se conservan en el volumen y no reescriben este archivo.
# npm run setup:local genera un hash y una contraseña aleatoria para pruebas.
# Para otra contraseña: node scripts/hash-password.mjs (entrada por stdin).
ADMIN_PASSWORD_HASH=
DATABASE_PATH=/app/data/contacts.sqlite
# Solo configurar si hay un proxy de confianza delante (IP o CIDR).
TRUST_PROXY=

# En local Mailpit captura los correos: http://localhost:8025
MAIL_TRANSPORT=smtp
MAIL_FROM=Resolution Solar Energy <web@resolution.test>
MAIL_TO=admin@resolution.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
