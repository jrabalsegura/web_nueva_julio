[Unit]
Description=Resolution Solar Energy - web y solicitudes de contacto
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=resolution-solar
Image=localhost/resolution-solar:current
Pull=never
Network=bridge
PublishPort=127.0.0.1:3089:3000
EnvironmentFile=/etc/resolution-solar/app.env
Volume=/var/lib/resolution-solar/data:/app/data:rw,z
User=1000
Group=1000
RunInit=true
ReadOnly=true
ReadOnlyTmpfs=true
Tmpfs=/tmp:rw,size=64m,mode=1777,notmpcopyup
NoNewPrivileges=true
DropCapability=all
# Podman construye OCI por defecto y puede omitir el HEALTHCHECK del Dockerfile.
# Definirlo aquí permite usar también las imágenes ya construidas.
HealthCmd=node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill
LogDriver=journald
PodmanArgs=--stop-signal=SIGTERM --stop-timeout=30
PidsLimit=256

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
