# Podman --env-file: valores literales, sin comillas ni "export".
# Este archivo es una plantilla. Guardar los secretos en /etc/resolution-solar/app.env.
APP_ORIGIN=https://resolutionsolarenergy.es
APP_ADDITIONAL_ORIGINS=https://julio.joserabalsegura.com
PORT=3000
PUBLIC_DIR=/app/public
DATABASE_PATH=/app/data/contacts.sqlite
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Pegar la IP Gateway real del contenedor, obtenida en el paso 5 de DEPLOYMENT-SSH.md.
TRUST_PROXY=

# Mismo proveedor de las pruebas externas; requiere activar el nuevo destinatario.
MAIL_TRANSPORT=formsubmit
MAIL_TO=juliorabal@hotmail.com
# Con FormSubmit no hacen falta credenciales SMTP ni MAIL_FROM.
